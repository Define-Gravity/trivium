---
// Settings: LLM API key management.
// Keys are encrypted server-side (AES-GCM) and never returned to the client.
// This page only shows configured status and spend, never the keys themselves.
import { createApi } from "../lib/api";
import { env } from "cloudflare:workers";

const api = createApi(env.TRIVIUM_API as any);
import "../styles/global.css";

let status: Awaited<ReturnType<ReturnType<typeof createApi>["getKeyStatus"]>> | null = null;
let error: string | null = null;
let success: string | null = null;

try {
  status = await api.getKeyStatus();
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to load key status";
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const provider = String(form.get("provider") ?? "");
  const api_key = String(form.get("api_key") ?? "").trim();

  if ((provider === "openai" || provider === "gemini") && api_key) {
    try {
      await api.setApiKey(provider, api_key);
      success = `${provider === "openai" ? "OpenAI" : "Gemini"} key saved and encrypted.`;
      status = await api.getKeyStatus();
    } catch (e) {
      error = e instanceof Error ? e.message : "Failed to save key";
    }
  } else {
    error = "Provider and API key are required.";
  }
}

const fmtSpend = (usd: number) => `$${usd.toFixed(4)}`;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Settings — Trivium</title>
</head>
<body>
  <div class="container">
    <header class="site">
      <a href="/" class="wordmark">Trivium</a>
      <nav><a href="/settings" aria-current="page">Settings</a></nav>
    </header>

    <div class="page-head">
      <a class="crumb" href="/">&larr; Home</a>
      <h1>Settings</h1>
      <p class="lede">Bring your own LLM keys. Keys are encrypted with AES-GCM before storage and never displayed back.</p>
    </div>

    {error && <div class="alert alert-error" role="alert">{error}</div>}
    {success && <div class="alert alert-success" role="alert">{success}</div>}

    <section class="section" aria-label="LLM providers">
      <div class="provider-grid">
        <div class="card">
          <h3>OpenAI</h3>
          <div class="kv">
            <div class="kv-row">
              <span class="kv-key">Status</span>
              {status?.openai.configured
                ? <span class="kv-val ok">✓ Configured</span>
                : <span class="kv-val missing">Not configured</span>}
            </div>
            <div class="kv-row">
              <span class="kv-key">Spend</span>
              <span class="kv-val">{status ? fmtSpend(status.openai.spend_usd) : "—"}</span>
            </div>
            <div class="kv-row">
              <span class="kv-key">Model</span>
              <span class="kv-val">gpt-4o-mini</span>
            </div>
          </div>
          <form method="POST" style="margin-top: 1.1rem;">
            <input type="hidden" name="provider" value="openai" />
            <div class="field">
              <label for="openai-key">API key</label>
              <input type="password" id="openai-key" name="api_key" required autocomplete="off" class="mono-input"
                placeholder={status?.openai.configured ? "•••••••• (set — enter new to replace)" : "sk-..."} />
            </div>
            <button type="submit" class="btn btn-primary">
              {status?.openai.configured ? "Replace key" : "Save key"}
            </button>
          </form>
        </div>

        <div class="card">
          <h3>Gemini</h3>
          <div class="kv">
            <div class="kv-row">
              <span class="kv-key">Status</span>
              {status?.gemini.configured
                ? <span class="kv-val ok">✓ Configured</span>
                : <span class="kv-val missing">Not configured</span>}
            </div>
            <div class="kv-row">
              <span class="kv-key">Spend</span>
              <span class="kv-val">{status ? fmtSpend(status.gemini.spend_usd) : "—"}</span>
            </div>
            <div class="kv-row">
              <span class="kv-key">Model</span>
              <span class="kv-val">gemini-3.8-flash</span>
            </div>
          </div>
          <form method="POST" style="margin-top: 1.1rem;">
            <input type="hidden" name="provider" value="gemini" />
            <div class="field">
              <label for="gemini-key">API key</label>
              <input type="password" id="gemini-key" name="api_key" required autocomplete="off" class="mono-input"
                placeholder={status?.gemini.configured ? "•••••••• (set — enter new to replace)" : "AIza..."} />
            </div>
            <button type="submit" class="btn btn-primary">
              {status?.gemini.configured ? "Replace key" : "Save key"}
            </button>
          </form>
        </div>
      </div>
    </section>

    <section class="section" aria-label="How key storage works">
      <div class="card">
        <h3>How it works</h3>
        <ul class="clean">
          <li>Keys are encrypted with AES-GCM (PBKDF2-derived key from a server secret) before hitting D1.</li>
          <li>Workflows decrypt keys in-memory only, for the duration of the LLM call.</li>
          <li>Keys are never logged, never returned by any API, and never leave Cloudflare.</li>
          <li>Spend is tracked per provider from actual token usage reported by the API.</li>
        </ul>
      </div>
    </section>
  </div>
</body>
</html>
