---
// Task detail: forks, pipeline actions, audit ledger.
// All data fetched server-side. Actions POST back to this page.
import { createApi } from "../../lib/api";
import { env } from "cloudflare:workers";

const api = createApi(env.TRIVIUM_API as any);
import "../../styles/global.css";

const { id } = Astro.params;
if (!id) return Astro.redirect("/");

let error: string | null = null;
let task: Awaited<ReturnType<ReturnType<typeof createApi>["getTask"]>> | null = null;
let ledger: Awaited<ReturnType<ReturnType<typeof createApi>["getLedger"]>> | null = null;

// Handle action POSTs
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  const comment = String(form.get("comment") ?? "").trim().slice(0, 500);
  try {
    if (action === "review") await api.runReview(id);
    if (action === "merge") await api.merge(id, comment || undefined);
    if (action === "merge-real") await api.mergeReal(id, comment || undefined);
    if (action === "run-agents") {
      const provider = String(form.get("provider") ?? "openai");
      if (provider !== "openai" && provider !== "gemini") throw new Error("invalid provider");
      const result = await api.runAgents(id, provider);
      // Redirect to refresh and show updated fork statuses
      return Astro.redirect(`/tasks/${id}?ran=${result.started}`);
    }
  } catch (e) {
    error = e instanceof Error ? e.message : "Action failed";
  }
}

let keyStatus: Awaited<ReturnType<ReturnType<typeof createApi>["getKeyStatus"]>> | null = null;
try {
  keyStatus = await api.getKeyStatus();
} catch { /* keys endpoint may not exist on older deploys */ }

try {
  task = await api.getTask(id);
  ledger = await api.getLedger(id);
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to load task";
}

const stages = ["pending", "running", "review", "completed"];
const currentStage = task ? stages.indexOf(task.task.status) : -1;
// Once agents are dispatched the run card stays hidden: re-running agents
// on the same task is refused by the API, so the button must not reappear.
const agentsDispatched = ledger
  ? ledger.events.some((e: any) => e.event_type === "agent.started")
  : false;
const formatDate = (epoch: number) => new Date(epoch * 1000).toLocaleString();
const shortHash = (h: string) => h.length > 16 ? h.slice(0, 16) + "..." : h;

// Assemble per-fork review notes from the gate events in the ledger.
// The gate also writes a signed copy of each note to the reviewed commit
// as a git note (refs/notes/trivium/review).
const reviewNotes: {
  forkId: string; agentId: string; commitSha: string | null;
  passed: boolean | null; findings: string[]; tier: string | null;
  decision: string | null; reviewedAt: number | null;
}[] = [];
if (ledger && task) {
  const byFork = new Map<string, {
    forkId: string; passed: boolean | null; findings: string[];
    tier: string | null; decision: string | null;
    reviewedAt: number | null; commitSha: string | null;
  }>();
  const entry = (forkId: string) => {
    if (!byFork.has(forkId)) {
      byFork.set(forkId, { forkId, passed: null, findings: [], tier: null, decision: null, reviewedAt: null, commitSha: null });
    }
    return byFork.get(forkId)!;
  };
  for (const e of ledger.events) {
    let d: any = {};
    try { d = JSON.parse(e.details); } catch { /* not JSON, skip */ }
    if (!d.forkId) continue;
    if (e.event_type === "agent.completed" && d.commitSha) {
      entry(d.forkId).commitSha = d.commitSha;
    } else if (e.event_type === "gate.scans") {
      const r = entry(d.forkId);
      r.passed = d.passed ?? null;
      r.findings = Array.isArray(d.findings) ? d.findings : [];
      r.reviewedAt = e.created_at;
    } else if (e.event_type === "gate.tier") {
      entry(d.forkId).tier = d.tier ?? null;
    } else if (e.event_type === "fork.approved") {
      const r = entry(d.forkId); r.decision = "approved"; r.reviewedAt = e.created_at;
    } else if (e.event_type === "fork.quarantined") {
      const r = entry(d.forkId); r.decision = "quarantined"; r.reviewedAt = e.created_at;
    } else if (e.event_type === "fork.escalated") {
      const r = entry(d.forkId); r.decision = "awaiting_human"; r.reviewedAt = e.created_at;
    }
  }
  for (const f of task.forks) {
    const r = byFork.get(f.id);
    if (r && (r.decision || r.passed !== null)) {
      reviewNotes.push({ ...r, agentId: f.agent_id });
    }
  }
}
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trivium — {task?.task.repo ?? "Task"}</title>
</head>
<body>
  <div class="container">
    <header class="site">
      <a href="/" class="wordmark">Trivium</a>
      <nav><a href="/settings">Settings</a></nav>
    </header>

    <div class="page-head">
      <a class="crumb" href="/">&larr; All tasks</a>
      <div class="head-row">
        <h1>{task?.task.repo ?? "Task"}</h1>
        {task && <span class={`badge badge-${task.task.status}`}>{task.task.status}</span>}
      </div>
      {task && <p class="lede">{task.task.instructions}</p>}
      {task && (
        <div class="meta-row">
          <span>{task.task.agent_count} {task.task.agent_count === 1 ? "agent" : "agents"}</span>
          <span>Budget: <span class="mono">{task.task.budget_tokens.toLocaleString()}</span> tokens</span>
          <span>Created {formatDate(task.task.created_at)}</span>
        </div>
      )}
    </div>

    {error && <div class="alert alert-error" role="alert">{error}</div>}

    {task && (
      <>
        <ol class="stepper" aria-label="Pipeline progress">
          {stages.map((s, i) => (
            <li class={`step ${i === currentStage ? "active" : ""} ${i < currentStage ? "done" : ""}`} aria-current={i === currentStage ? "step" : undefined}>
              <span class="pip">{i < currentStage ? "✓" : i + 1}</span>
              {s}
            </li>
          ))}
        </ol>

        {task.task.status === "review" && (
          <div class="action-bar" style="flex-direction: column; align-items: stretch;">
            <form method="POST">
              <input type="hidden" name="action" value="review" />
              <button type="submit" class="btn btn-primary">Run review gates</button>
            </form>
            {(task.task as any).project_id ? (
              <form method="POST">
                <input type="hidden" name="action" value="merge-real" />
                <div class="field">
                  <label for="merge-comment">Review comment <span class="hint">Optional. Recorded in the ledger with the merge.</span></label>
                  <input type="text" id="merge-comment" name="comment" maxlength="500" placeholder="Why is this merge approved?" />
                </div>
                <button type="submit" class="btn">Merge to main</button>
              </form>
            ) : (
              <form method="POST">
                <input type="hidden" name="action" value="merge" />
                <div class="field">
                  <label for="merge-comment">Review comment <span class="hint">Optional. Recorded in the ledger with the merge.</span></label>
                  <input type="text" id="merge-comment" name="comment" maxlength="500" placeholder="Why is this merge approved?" />
                </div>
                <button type="submit" class="btn">Merge winner</button>
              </form>
            )}
            <p class="note">Review gates scan each fork before anything merges.</p>
          </div>
        )}

        {task.task.status === "running" && !agentsDispatched && task.forks.some((f: any) => f.status !== "completed") && (
          <div class="card">
            <h3>Run agents on Cloudflare</h3>
            {keyStatus && (keyStatus.openai.configured || keyStatus.gemini.configured) ? (
              <form method="POST" class="form-row-inline">
                <input type="hidden" name="action" value="run-agents" />
                <div class="field">
                  <label for="provider">Provider</label>
                  <select id="provider" name="provider">
                    {keyStatus.openai.configured && <option value="openai">OpenAI (gpt-4o-mini)</option>}
                    {keyStatus.gemini.configured && <option value="gemini">Gemini (3.8-flash)</option>}
                  </select>
                </div>
                <button type="submit" class="btn btn-primary">Start agents</button>
              </form>
            ) : (
              <p style="color: var(--muted); margin-bottom: 0;">
                No LLM keys configured. <a href="/settings">Add your API keys in Settings</a> to run agents on Cloudflare.
              </p>
            )}
            <p class="event-meta" style="margin-top: 0.75rem; margin-bottom: 0;">
              Each fork gets its own Workflow. Agents clone, call the LLM, commit with Trivium trailers, and push.
            </p>
          </div>
        )}

        <section class="section" aria-label="Agent forks">
          <div class="section-head">
            <h2>Agent forks <span class="count">({task.forks.length})</span></h2>
          </div>
          <div class="fork-grid">
            {task.forks.map((f) => (
              <div class={`fork-card ${f.status === "merged" ? "winner" : ""}`}>
                <div class="fork-top">
                  <span class="fork-agent">{f.agent_id}</span>
                  <span class={`badge badge-${f.status}`}>{f.status}</span>
                </div>
                <p class="fork-detail">Repo <span class="mono">{f.repo_name}</span></p>
                <p class="fork-detail">Token expires {formatDate(f.token_expiry)}</p>
                {f.completed_at && <p class="fork-detail">Completed {formatDate(f.completed_at)}</p>}
                {f.status === "merged" && <p class="fork-selected">✓ Selected</p>}
              </div>
            ))}
          </div>
        </section>

        {reviewNotes.length > 0 && (
          <section class="section" aria-label="Review notes">
            <div class="section-head">
              <h2>Review notes <span class="count">({reviewNotes.length})</span></h2>
              <p>What the review gate found in each fork. A signed copy is also written to the reviewed commit as a git note.</p>
            </div>
            <div class="row-list">
              {reviewNotes.map((n) => (
                <div class="card" style="margin-bottom: 0;">
                  <div class="fork-top">
                    <span class="fork-agent">{n.agentId}</span>
                    {n.decision && (
                      <span class={`badge badge-${n.decision === "awaiting_human" ? "awaiting_human" : n.decision}`}>
                        {n.decision === "awaiting_human" ? "awaiting human" : n.decision}
                      </span>
                    )}
                  </div>
                  <div class="kv">
                    <div class="kv-row">
                      <span class="kv-key">Scans</span>
                      {n.passed === null
                        ? <span class="kv-val missing">—</span>
                        : n.passed
                          ? <span class="kv-val ok">✓ Passed</span>
                          : <span class="kv-val" style="color: var(--red);">✗ Failed</span>}
                    </div>
                    <div class="kv-row">
                      <span class="kv-key">Risk tier</span>
                      <span class="kv-val">{n.tier ?? "—"}</span>
                    </div>
                    {n.commitSha && (
                      <div class="kv-row">
                        <span class="kv-key">Commit</span>
                        <span class="kv-val">{shortHash(n.commitSha)}</span>
                      </div>
                    )}
                    {n.reviewedAt && (
                      <div class="kv-row">
                        <span class="kv-key">Reviewed</span>
                        <span class="kv-val" style="font-family: var(--font-sans);">{formatDate(n.reviewedAt)}</span>
                      </div>
                    )}
                  </div>
                  {n.findings.length > 0 ? (
                    <ul class="clean">
                      {n.findings.map((f) => <li class="mono">{f}</li>)}
                    </ul>
                  ) : (
                    <p class="event-meta" style="margin-bottom: 0;">No findings.</p>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <section class="section" aria-label="Audit ledger">
          <div class="section-head">
            <h2>
              Audit ledger
              {ledger && (
                <span class={`verify ${ledger.valid ? "ok" : "bad"}`} style="margin-left: 0.6rem;">
                  {ledger.valid ? "✓ chain valid" : "✗ chain broken"}
                </span>
              )}
            </h2>
            <p>Every event is hash-chained. If anyone edits history, the chain breaks.</p>
          </div>
          <div class="card">
            <div class="timeline">
              {ledger?.events.map((e) => (
                <div class="event">
                  <div class="event-type">{e.event_type}</div>
                  <div class="event-meta">{e.actor} &middot; {formatDate(e.created_at)}</div>
                  <div class="event-details">{e.details.slice(0, 160)}{e.details.length > 160 ? "..." : ""}</div>
                  <div class="event-hash">{shortHash(e.hash)}</div>
                </div>
              ))}
            </div>
          </div>
        </section>
      </>
    )}
  </div>
</body>
</html>
