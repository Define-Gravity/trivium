---
// Task detail: forks, pipeline actions, audit ledger.
// All data fetched server-side. Actions POST back to this page.
import { createApi } from "../../lib/api";
import { env } from "cloudflare:workers";

const api = createApi(env.TRIVIUM_API as any);
import "../../styles/global.css";

const { id } = Astro.params;
if (!id) return Astro.redirect("/");

let error: string | null = null;
let task: Awaited<ReturnType<ReturnType<typeof createApi>["getTask"]>> | null = null;
let ledger: Awaited<ReturnType<ReturnType<typeof createApi>["getLedger"]>> | null = null;

// Handle action POSTs
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  try {
    if (action === "review") await api.runReview(id);
    if (action === "merge") await api.merge(id);
    if (action === "merge-real") await api.mergeReal(id);
    if (action === "run-agents") {
      const provider = String(form.get("provider") ?? "openai");
      if (provider !== "openai" && provider !== "gemini") throw new Error("invalid provider");
      const result = await api.runAgents(id, provider);
      // Redirect to refresh and show updated fork statuses
      return Astro.redirect(`/tasks/${id}?ran=${result.started}`);
    }
  } catch (e) {
    error = e instanceof Error ? e.message : "Action failed";
  }
}

let keyStatus: Awaited<ReturnType<ReturnType<typeof createApi>["getKeyStatus"]>> | null = null;
try {
  keyStatus = await api.getKeyStatus();
} catch { /* keys endpoint may not exist on older deploys */ }

try {
  task = await api.getTask(id);
  ledger = await api.getLedger(id);
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to load task";
}

const stages = ["pending", "running", "review", "completed"];
const currentStage = task ? stages.indexOf(task.task.status) : -1;
const formatDate = (epoch: number) => new Date(epoch * 1000).toLocaleString();
const shortHash = (h: string) => h.length > 16 ? h.slice(0, 16) + "..." : h;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trivium — {task?.task.repo ?? "Task"}</title>
</head>
<body>
  <div class="container">
    <header>
      <div>
        <h1><a href="/" style="color: inherit;">←</a> {task?.task.repo ?? "Task"}</h1>
        <p>{task?.task.instructions}</p>
      </div>
      {task && <span class={`badge badge-${task.task.status}`}>{task.task.status}</span>}
    </header>

    {error && <div class="card" style="border-color: var(--red); color: var(--red);">{error}</div>}

    {task && (
      <>
        <div class="pipeline">
          {stages.map((s, i) => (
            <div class={`stage ${i === currentStage ? "active" : ""} ${i < currentStage ? "done" : ""}`}>
              {s}
            </div>
          ))}
        </div>

        {task.task.status === "review" && (
          <div class="actions">
            <form method="POST" style="display: inline;">
              <input type="hidden" name="action" value="review" />
              <button type="submit" class="btn btn-primary">Run review gates</button>
            </form>
            {(task.task as any).project_id ? (
              <form method="POST" style="display: inline;">
                <input type="hidden" name="action" value="merge-real" />
                <button type="submit" class="btn">Merge to main</button>
              </form>
            ) : (
              <form method="POST" style="display: inline;">
                <input type="hidden" name="action" value="merge" />
                <button type="submit" class="btn">Merge winner</button>
              </form>
            )}
          </div>
        )}

        {task.task.status === "running" && task.forks.some((f: any) => f.status !== "completed") && (
          <div class="card" style="margin-bottom: 1.5rem;">
            <h3 style="margin-top: 0;">Run agents on Cloudflare</h3>
            {keyStatus && (keyStatus.openai.configured || keyStatus.gemini.configured) ? (
              <form method="POST" style="display: flex; gap: 0.75rem; align-items: end;">
                <input type="hidden" name="action" value="run-agents" />
                <div class="form-row" style="margin: 0;">
                  <label for="provider">Provider</label>
                  <select id="provider" name="provider">
                    {keyStatus.openai.configured && <option value="openai">OpenAI (gpt-4o-mini)</option>}
                    {keyStatus.gemini.configured && <option value="gemini">Gemini (2.0-flash)</option>}
                  </select>
                </div>
                <button type="submit" class="btn btn-primary">Start agents</button>
              </form>
            ) : (
              <p style="color: var(--muted); margin-bottom: 0;">
                No LLM keys configured. <a href="/settings">Add your API keys in Settings</a> to run agents on Cloudflare.
              </p>
            )}
            <p class="task-meta" style="margin-top: 0.75rem; margin-bottom: 0;">
              Each fork gets its own Workflow. Agents clone, call the LLM, commit with Trivium trailers, and push.
            </p>
          </div>
        )}

        <h2>Agent forks ({task.forks.length})</h2>
        <div class="fork-grid">
          {task.forks.map((f) => (
            <div class={`fork-card ${f.status === "merged" ? "winner" : ""}`}>
              <h3>
                {f.agent_id}
                <span class={`badge badge-${f.status}`}>{f.status}</span>
              </h3>
              <p class="fork-detail">Repo: {f.repo_name}</p>
              <p class="fork-detail">Token expires: {formatDate(f.token_expiry)}</p>
              {f.completed_at && <p class="fork-detail">Completed: {formatDate(f.completed_at)}</p>}
              {f.status === "merged" && <p style="color: var(--green); font-weight: 600;">✓ Selected</p>}
            </div>
          ))}
        </div>

        <h2>
          Audit ledger
          {ledger && (
            <span class={`verify ${ledger.valid ? "ok" : "bad"}`} style="margin-left: 0.75rem;">
              {ledger.valid ? "✓ chain valid" : "✗ chain broken"}
            </span>
          )}
        </h2>
        <div class="card">
          <div class="timeline">
            {ledger?.events.map((e) => (
              <div class="event">
                <div class="event-type">{e.event_type}</div>
                <div class="event-meta">
                  {e.actor} &middot; {formatDate(e.created_at)}
                </div>
                <div class="event-meta">{e.details.slice(0, 160)}{e.details.length > 160 ? "..." : ""}</div>
                <div class="event-hash">{shortHash(e.hash)}</div>
              </div>
            ))}
          </div>
        </div>
      </>
    )}
  </div>
</body>
</html>
