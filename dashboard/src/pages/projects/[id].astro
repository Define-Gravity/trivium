---
// Project detail page: shows repo info, remote URL for bootstrapping,
// and tasks belonging to this project.
import { createApi } from "../../lib/api";
import { env } from "cloudflare:workers";

const api = createApi(env.TRIVIUM_API as any);
import "../../styles/global.css";

const { id } = Astro.params;

let project: { id: string; name: string; repo_name: string; created_at: number } | null = null;
let remote: { remote: string; token: string; expires_in: number } | null = null;
let tasks: Awaited<ReturnType<ReturnType<typeof createApi>["listTasks"]>> = [];
let error: string | null = null;

try {
  const projects = await api.listProjects();
  project = projects.find((p) => p.id === id) ?? null;
  if (!project) {
    error = "Project not found.";
  } else {
    [remote, tasks] = await Promise.all([
      api.getProjectRemote(id!),
      api.listTasks(),
    ]);
    // Filter tasks to this project (task.project_id matches)
    tasks = tasks.filter((t: any) => t.project_id === id);
  }
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to load project";
}

const formatDate = (epoch: number) =>
  new Date(epoch * 1000).toLocaleString();

// Build a copy-paste git command. Token is short-lived; the page
// fetches a fresh one on each load.
const gitCommand = remote
  ? `git remote add artifacts https://x:${remote.token}@${remote.remote.replace(/^https:\/\//, "")}\ngit push artifacts main`
  : "";
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{project ? project.name : "Project"} — Trivium</title>
</head>
<body>
  <div class="container">
    <header class="site">
      <a href="/" class="wordmark">Trivium</a>
      <nav><a href="/settings">Settings</a></nav>
    </header>

    <div class="page-head">
      <a class="crumb" href="/">&larr; All projects</a>
      <h1>{project ? project.name : "Project"}</h1>
      {project && (
        <div class="meta-row">
          <span class="mono">{project.repo_name}</span>
          <span>Created {formatDate(project.created_at)}</span>
        </div>
      )}
    </div>

    {error && <div class="alert alert-error" role="alert">{error}</div>}

    {project && remote && (
      <section class="section" aria-label="Bootstrap">
        <div class="card">
          <h3>Bootstrap this repo</h3>
          <p style="color: var(--muted); margin-top: 0;">
            Push an existing repo into the project. The token expires in {Math.round(remote.expires_in / 60)} minutes; reload the page for a fresh one.
          </p>
          <pre class="code"><code>{gitCommand}</code></pre>
          <p class="event-meta" style="margin-top: 0.75rem; margin-bottom: 0;">
            Remote: <span class="mono">{remote.remote}</span>
          </p>
        </div>
      </section>
    )}

    {project && (
      <section class="section" aria-label="Project tasks">
        <div class="section-head">
          <h2>Tasks in this project <span class="count">{tasks.length > 0 ? `(${tasks.length})` : ""}</span></h2>
        </div>
        {tasks.length === 0 && !error && (
          <div class="empty">No tasks yet for this project.</div>
        )}
        <div class="row-list">
          {tasks.map((t) => (
            <a href={`/tasks/${t.id}`} class="row">
              <div class="row-main">
                <div class="row-title">{t.repo}</div>
                <div class="row-meta">
                  <span>{t.agent_count} {t.agent_count === 1 ? "agent" : "agents"}</span>
                  <span>{formatDate(t.created_at)}</span>
                  <span class="row-id">{t.id}</span>
                </div>
              </div>
              <div class="row-side">
                <span class={`badge badge-${t.status}`}>{t.status}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</body>
</html>
