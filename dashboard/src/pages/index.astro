---
// Homepage: projects and tasks. Server-rendered from the Trivium API.
import { createApi } from "../lib/api";
import { env } from "cloudflare:workers";

const api = createApi(env.TRIVIUM_API as any);
import "../styles/global.css";

let tasks: Awaited<ReturnType<ReturnType<typeof createApi>["listTasks"]>> = [];
let projects: Awaited<ReturnType<ReturnType<typeof createApi>["listProjects"]>> = [];
let error: string | null = null;

try {
  [tasks, projects] = await Promise.all([api.listTasks(), api.listProjects()]);
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to load data";
}

// Handle form POSTs (distinguished by hidden _form field)
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const formKind = String(form.get("_form") ?? "");

  if (formKind === "project") {
    const name = String(form.get("name") ?? "").trim();
    if (name) {
      try {
        const { project_id } = await api.createProject(name);
        return Astro.redirect(`/projects/${project_id}`);
      } catch (e) {
        error = e instanceof Error ? e.message : "Failed to create project";
      }
    } else {
      error = "Project name is required.";
    }
  } else {
    // task form (default)
    const repo = String(form.get("repo") ?? "").trim();
    const instructions = String(form.get("instructions") ?? "").trim();
    const agent_count = Math.min(Math.max(parseInt(String(form.get("agent_count") ?? "3"), 10) || 3, 1), 5);
    const project_id = String(form.get("project_id") ?? "").trim() || undefined;

    if (repo && instructions) {
      try {
        const { task_id } = await api.createTask(repo, instructions, agent_count, project_id);
        return Astro.redirect(`/tasks/${task_id}`);
      } catch (e) {
        error = e instanceof Error ? e.message : "Failed to create task";
      }
    } else {
      error = "Repository name and instructions are required.";
    }
  }
}

const formatDate = (epoch: number) =>
  new Date(epoch * 1000).toLocaleString();
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trivium — Parallel Agent Pipeline</title>
</head>
<body>
  <div class="container">
    <header class="site">
      <a href="/" class="wordmark">Trivium</a>
      <nav><a href="/settings">Settings</a></nav>
    </header>

    <div class="page-head">
      <p class="kicker">Dashboard</p>
      <h1>One task in. N agents. One audited result.</h1>
    </div>

    {error && <div class="alert alert-error" role="alert">{error}</div>}

    <section class="section" aria-label="Projects">
      <div class="section-head">
        <h2>Projects</h2>
        <p>A project is a repo on Artifacts that agents work against.</p>
      </div>

      <form class="form-card" method="POST">
        <input type="hidden" name="_form" value="project" />
        <h3>New project</h3>
        <div class="field">
          <label for="project-name">Project name</label>
          <input type="text" id="project-name" name="name" required maxlength="64" placeholder="my-project" />
        </div>
        <button type="submit" class="btn btn-primary">Create project</button>
      </form>

      {projects.length === 0 && !error && (
        <div class="empty">No projects yet. Create one above.</div>
      )}
      <div class="row-list">
        {projects.map((p) => (
          <a href={`/projects/${p.id}`} class="row project-card">
            <div class="row-main">
              <div class="row-title">{p.name}</div>
              <div class="row-meta">
                <span class="mono">{p.repo_name}</span>
                <span>{formatDate(p.created_at)}</span>
              </div>
            </div>
            <div class="row-side">
              <span class="row-arrow" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-label="New task">
      <div class="section-head">
        <h2>New task</h2>
        <p>Describe the work. Each agent gets its own fork and works it independently.</p>
      </div>
      <form class="form-card" method="POST">
        <input type="hidden" name="_form" value="task" />
        <div class="field">
          <label for="repo">Repository name</label>
          <input type="text" id="repo" name="repo" required maxlength="64" placeholder="my-project" />
        </div>
        <div class="field">
          <label for="instructions">Instructions for agents</label>
          <textarea id="instructions" name="instructions" required maxlength="2000" placeholder="Describe what the agents should build..."></textarea>
        </div>
        <div class="form-row-inline">
          <div class="field">
            <label for="agent_count">Agents (1-5)</label>
            <input type="number" id="agent_count" name="agent_count" value="3" min="1" max="5" />
          </div>
          <div class="field">
            <label for="project_id">Project (optional)</label>
            <select id="project_id" name="project_id">
              <option value="">No project (legacy)</option>
              {projects.map((p) => (
                <option value={p.id}>{p.name}</option>
              ))}
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Dispatch agents</button>
      </form>
    </section>

    <section class="section" aria-label="Tasks">
      <div class="section-head">
        <h2>Tasks <span class="count">{tasks.length > 0 ? `(${tasks.length})` : ""}</span></h2>
      </div>
      {tasks.length === 0 && !error && (
        <div class="empty">No tasks yet. Dispatch one above.</div>
      )}
      <div class="row-list">
        {tasks.map((t) => (
          <a href={`/tasks/${t.id}`} class="row">
            <div class="row-main">
              <div class="row-title">{t.repo}</div>
              <div class="row-meta">
                <span>{t.agent_count} {t.agent_count === 1 ? "agent" : "agents"}</span>
                <span>{formatDate(t.created_at)}</span>
                <span class="row-id">{t.id}</span>
              </div>
            </div>
            <div class="row-side">
              <span class={`badge badge-${t.status}`}>{t.status}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</body>
</html>
